{
  "name": "@monox/web",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "deployment": {
    "schemaVersion": "2",
    "enabled": true,
    "id": "web",
    "kind": "service",
    "build": {
      "strategy": "dockerfile",
      "context": ".",
      "dockerfile": "infra/docker/Dockerfile.node",
      "script": "build"
    },
    "runtime": {
      "language": "javascript",
      "framework": "node-http",
      "command": [
        "node",
        "apps/web/src/server.mjs"
      ],
      "workingDirectory": "."
    },
    "network": {
      "exposure": "public",
      "ports": [
        {
          "name": "http",
          "containerPort": 3001,
          "servicePort": 80
        }
      ],
      "routes": [
        {
          "path": "/",
          "pathType": "Prefix"
        }
      ]
    },
    "probes": {
      "startup": {
        "type": "http",
        "path": "/livez",
        "port": "http",
        "periodSeconds": 2,
        "failureThreshold": 30
      },
      "readiness": {
        "type": "http",
        "path": "/readyz",
        "port": "http",
        "periodSeconds": 5
      },
      "liveness": {
        "type": "http",
        "path": "/livez",
        "port": "http",
        "periodSeconds": 10
      }
    },
    "env": {
      "values": {
        "NODE_ENV": "production"
      },
      "secretRefs": []
    },
    "resources": {
      "requests": {
        "cpu": "50m",
        "memory": "64Mi"
      },
      "limits": {
        "cpu": "250m",
        "memory": "256Mi"
      },
      "accelerators": []
    },
    "identity": {
      "automountServiceAccountToken": false
    },
    "telemetry": {
      "metrics": {
        "enabled": true,
        "path": "/metrics",
        "port": 3001
      },
      "traces": {
        "enabled": false
      },
      "logs": {
        "enabled": true
      }
    },
    "lifecycle": {
      "terminationGracePeriodSeconds": 30,
      "preStopCommand": [],
      "drain": {
        "enabled": false,
        "timeoutSeconds": 20
      }
    },
    "scaling": {
      "mode": "hpa",
      "minReplicas": 1,
      "maxReplicas": 3,
      "metrics": [
        {
          "type": "cpu",
          "target": 70
        }
      ],
      "behavior": {
        "scaleDownStabilizationSeconds": 300
      }
    },
    "variants": {},
    "environments": {},
    "adapterOverrides": {}
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs",
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "@monox/app-runtime": "workspace:^"
  }
}
