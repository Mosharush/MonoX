      "replicas_min": 0,
      "replicas_max": 20,
      "pre_stop": ["node", "dist/drain.mjs"],
      "drain": true,
      "drain_timeout": 240,
      "termination_grace_period": 300
    },
    "expected": {
      "/output/kind": "worker",
      "/output/network/exposure": "none",
      "/output/network/ports": [],
      "/output/lifecycle/drain/enabled": true,
      "/output/lifecycle/drain/timeoutSeconds": 240,
      "/output/lifecycle/terminationGracePeriodSeconds": 300,
      "/output/scaling/mode": "keda",
      "/output/scaling/minReplicas": 0,
      "/output/scaling/maxReplicas": 20,
      "/output/scaling/metrics/0/type": "rabbitmq",
      "/output/scaling/metrics/0/sourceRef": "RABBITMQ_URL",
      "/output/scaling/metrics/0/queue": "events",
      "/output/scaling/metrics/0/target": 25,
      "/output/env/secretRefs/0/name": "rabbitmq-connection",
      "/output/env/secretRefs/0/target": "RABBITMQ_URL"
    },
    "manualReviewCodes": ["secret-binding", "worker-lifecycle"]
  },
  {
