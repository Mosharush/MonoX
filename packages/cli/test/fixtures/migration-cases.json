    "manualReviewCodes": ["target-binding"]
  },
  {
    "name": "queue worker",
    "input": {
      "name": "events-worker",
      "type": "queue-worker",
      "language": "typescript",
      "command": ["node", "dist/worker.mjs"],
      "queue": "events",
