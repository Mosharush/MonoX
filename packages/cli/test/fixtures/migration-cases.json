[
  {
    "name": "stateless service",
    "input": {
      "name": "catalog-api",
      "type": "typescript",
      "context": ".",
      "dockerfile": "Dockerfile",
      "command": ["node", "dist/server.mjs"],
      "port": 3000,
      "service_port": 80,
      "public": true,
      "domain": "api.example.invalid",
      "health_path": "/healthz",
      "cpu_request": "100m",
      "memory_request": "128Mi",
