{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monox:deployment:v1",
  "title": "MonoX deployment configuration v1",
  "description": "Provider-neutral application deployment contract. Secret values are intentionally unsupported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "namespace",
    "image",
    "container",
    "service",
    "probes",
    "resources",
    "autoscaling",
    "networkPolicy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "name": {
      "$ref": "#/$defs/dnsLabel"
    },
    "namespace": {
      "$ref": "#/$defs/dnsLabel"
    },
    "createNamespace": {
      "type": "boolean",
      "default": true
    },
    "labels": {
      "$ref": "#/$defs/stringMap"
    },
    "annotations": {
      "$ref": "#/$defs/stringMap"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 3
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600,
      "default": 60
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent"
        },
        "pullSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dnsLabel"
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "$ref": "#/$defs/port"
        },
        "command": {
          "$ref": "#/$defs/stringArray"
        },
        "args": {
          "$ref": "#/$defs/stringArray"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "envFromSecrets": {
          "type": "array",
          "uniqueItems": true,
          "description": "Names of externally managed Kubernetes Secrets. Values never belong in this file.",
          "items": {
            "$ref": "#/$defs/dnsLabel"
          }
        },
        "writableTmp": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "$ref": "#/$defs/dnsLabel"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "default": "ClusterIP"
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "$ref": "#/$defs/dnsSubdomain"
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "default": "/"
        },
        "pathType": {
          "enum": ["Exact", "Prefix", "ImplementationSpecific"],
          "default": "Prefix"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "$ref": "#/$defs/dnsLabel"
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": {
          "$ref": "#/$defs/httpProbe"
        },
        "readiness": {
          "$ref": "#/$defs/httpProbe"
        },
        "liveness": {
          "$ref": "#/$defs/httpProbe"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourcePair"
        },
        "limits": {
          "$ref": "#/$defs/resourcePair"
        }
      }
    },
    "rollingUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSurge": {
          "$ref": "#/$defs/intOrPercent",
          "default": "25%"
        },
        "maxUnavailable": {
          "$ref": "#/$defs/intOrPercent",
          "default": 0
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "minAvailable": {
          "$ref": "#/$defs/intOrPercent"
        },
        "maxUnavailable": {
          "$ref": "#/$defs/intOrPercent"
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "whenUnsatisfiable": {
          "enum": ["DoNotSchedule", "ScheduleAnyway"],
          "default": "ScheduleAnyway"
        },
        "topologyKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["topology.kubernetes.io/zone", "kubernetes.io/hostname"]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "egress"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkPeer"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns", "https", "sameNamespace"],
          "properties": {
            "dns": {
              "type": "boolean"
            },
            "https": {
              "type": "boolean"
            },
            "sameNamespace": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["none", "hpa", "keda"]
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cpuUtilization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "memoryUtilization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triggers"],
          "properties": {
            "pollingInterval": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "cooldownPeriod": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "triggers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/kedaTrigger"
              }
            }
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1,
          "default": 10001
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1,
          "default": 10001
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1,
          "default": 10001
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 253
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*m|0\\.[0-9]+|[1-9][0-9]*(?:\\.[0-9]+)?)$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti)$"
        }
      }
    },
    "httpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "intOrPercent": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?:100|[1-9]?[0-9])%$"
        }
      ]
    },
    "networkPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceLabels": {
          "$ref": "#/$defs/stringMap"
        },
        "podLabels": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "kedaTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "metadata"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "metadata": {
          "$ref": "#/$defs/stringMap"
        },
        "authenticationRef": {
          "$ref": "#/$defs/dnsLabel"
        }
      }
    }
  }
}
