{
  "$schema": "./schemas/monox.schema.json",
  "schemaVersion": "2",
  "project": {
    "name": "monox",
    "workspaceGlobs": ["apps/*", "packages/*", "infra/*"],
    "defaultEnvironment": "local"
  },
  "boundaries": {
    "apps": ["packages"],
    "packages": ["packages"],
    "infra": ["packages"]
  },
  "workloadProfiles": {},
  "environments": {
    "local": {
      "production": false,
      "protected": false,
      "bindings": [{ "target": "local-docker", "selector": { "workloads": ["*"] } }]
    },
    "preview": {
      "production": false,
      "protected": false,
      "bindings": [{ "target": "preview-kubernetes", "selector": { "workloads": ["*"] } }]
    },
    "staging": {
      "production": false,
      "protected": true,
      "bindings": [{ "target": "staging-kubernetes", "selector": { "workloads": ["*"] } }]
    },
    "production": {
      "production": true,
      "protected": true,
      "bindings": [{ "target": "production-kubernetes", "selector": { "workloads": ["*"] } }]
    }
  },
  "targets": {
    "local-docker": {
      "provider": "generic",
      "provisioner": "none",
      "transport": "local",
      "runtime": "docker",
      "bindings": { "namespace": "monox-local" }
    },
    "preview-kubernetes": {
      "provider": "generic",
      "provisioner": "none",
      "transport": "kubernetes-api",
      "runtime": "kubernetes",
      "bindings": {
        "namespace": "monox-preview",
        "registry": "ghcr.io/mosharush",
        "identityRef": "github-oidc",
        "secretStoreRef": "external-secrets"
      },
      "clusterRef": "preview-cluster",
      "ttlHours": 24
    },
    "staging-kubernetes": {
      "provider": "generic",
      "provisioner": "none",
      "transport": "kubernetes-api",
      "runtime": "kubernetes",
      "bindings": {
        "namespace": "monox-staging",
        "registry": "ghcr.io/mosharush",
        "identityRef": "github-oidc",
        "secretStoreRef": "external-secrets"
      },
      "clusterRef": "staging-cluster"
    },
    "production-kubernetes": {
      "provider": "generic",
      "provisioner": "none",
      "transport": "kubernetes-api",
      "runtime": "kubernetes",
      "bindings": {
        "namespace": "monox",
        "registry": "ghcr.io/mosharush",
        "domain": "monox.dev",
        "identityRef": "github-oidc",
        "secretStoreRef": "external-secrets"
      },
      "clusterRef": "production-cluster"
    }
  },
  "addons": {}
}
