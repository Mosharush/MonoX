[
  {
    "name": "product-specific root property",
    "path": "$.productTier",
    "document": {
      "$schema": "./schemas/v2/monox.schema.json",
      "schemaVersion": "2",
      "productTier": "internal",
      "project": {
        "name": "example",
        "workspaceGlobs": ["apps/*"]
      },
      "boundaries": {},
      "workloadProfiles": {},
      "environments": {
        "development": {
          "bindings": [{ "target": "local-docker", "selector": { "workloads": ["*"] } }]
        }
      },
      "targets": {
        "local-docker": {
          "provider": "generic",
          "provisioner": "none",
          "transport": "local",
          "runtime": "docker"
        }
      },
      "addons": {}
    }
  },
  {
    "name": "wrong schema version",
    "path": "$.schemaVersion",
