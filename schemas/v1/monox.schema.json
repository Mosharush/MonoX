{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monox:project:v1",
  "title": "MonoX project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "workspaceGlobs", "boundaries", "environments", "deployment", "applications"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "workspaceGlobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "registry", "imagePullPolicy", "autoscaling"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "registry": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minReplicas", "maxReplicas", "cpuTarget"],
          "properties": {
            "mode": { "enum": ["hpa", "keda"] },
            "minReplicas": { "type": "integer", "minimum": 0 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "cpuTarget": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "workspace", "port", "healthPath", "public"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "workspace": { "type": "string", "pattern": "^@monox/[a-z][a-z0-9-]*$" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "healthPath": { "type": "string", "pattern": "^/" },
          "public": { "type": "boolean" }
        }
      }
    }
  }
}
